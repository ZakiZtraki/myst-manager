# MCP Server configuration — copy to .env and fill in values

# Path inside the container where portfolio.json lives (backed by a Docker volume)
PORTFOLIO_FILE=/data/portfolio.json

# Set to 'true' to enable Binance balance sync
USE_BINANCE=false

# Binance API credentials (required only when USE_BINANCE=true)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Server network binding
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Optional: protect the SSE endpoint with a bearer token.
# When set, clients must send:  Authorization: Bearer <MCP_API_KEY>
# Leave blank to rely on network-level security (VPN + SWAG).
MCP_API_KEY=
